# GitHub
GH_TOKEN_CUSTOM=ghp_xxx

# Discord
DISCORD_BOT_TOKEN=xxx
DISCORD_CHANNEL_ID=123456789012345678

# Storage (default works for Fly; for local dev use ./codictator.db)
DB_PATH=./codictator.db

# Loop
CHECK_INTERVAL=300
INACTIVE_THRESHOLD=1440

# Ollama
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30
