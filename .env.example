# GitHub
GH_TOKEN_CUSTOM=ghp_xxx

# Discord
DISCORD_BOT_TOKEN=xxx
DISCORD_CHANNEL_ID=123456789012345678

# Storage — local file always exists. If TURSO_DB_URL is set, it syncs there.
DB_PATH=./codictator.db
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# Loop
CHECK_INTERVAL=900
INACTIVE_THRESHOLD=1440

# Ollama
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30
